#!/usr/bin/env bash
set -euo pipefail

# separate-vocals
# Separa vocales e instrumentales de un archivo de audio usando Demucs.
#
# Uso:  ./separate-vocals [-n modelo] <input> [nombre]
#
# Instala Demucs automáticamente (una sola vez con uv tool) y guarda
# los resultados como WAV (16-bit) en materiales/raw/.

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OUTDIR="${OUTDIR:-$SCRIPT_DIR/materiales/raw}"

usage() {
  cat >&2 <<EOF
Uso: $(basename "$0") [-n modelo] <input> [nombre]

Separa vocales e instrumentales de un archivo de audio usando Demucs.
El resultado son dos archivos WAV (16-bit, 44.1 kHz estéreo).

Argumentos:
  input     Archivo de audio de entrada (.mp3, .wav, .flac, etc.)
  nombre    Nombre base para los archivos de salida
            Por defecto: nombre del archivo de entrada (sin extensión)

Opciones:
  -n, --model <modelo>  Modelo de Demucs a usar (por defecto: htdemucs)
                        Otros: htdemucs_ft, mdx_extra_q, mdx_q, mdx_extra

Requiere: uv (instala Demucs automáticamente la primera vez)

Los archivos se guardan en: $OUTDIR/
EOF
  exit 0
}

# --- Option parsing ---
MODEL="htdemucs"

while [ "$#" -gt 0 ]; do
  case "$1" in
    -n|--model) MODEL="${2:?Falta nombre del modelo}"; shift 2 ;;
    --help|-h) usage ;;
    -*) echo "  ✗ Opción desconocida: $1" >&2; usage ;;
    *) break ;;
  esac
done

INPUT="${1:?Falta archivo de entrada}"
CUSTOM="${2:-}"

# --- Validate input file ---
[ -f "$INPUT" ] || { echo "  ✗ No existe: $INPUT" >&2; exit 1; }

# --- Output directory ---
mkdir -p "$OUTDIR"
if ! touch "$OUTDIR/.write-test" 2>/dev/null; then
  echo "  ✗ No se puede escribir en $OUTDIR" >&2
  exit 1
fi
rm -f "$OUTDIR/.write-test"

# --- Determine output basename ---
sanitize() {
  local s
  s=$(echo "$1" | sed 's/[<>:"/\\|?*]/_/g; s/  */ /g; s/^[[:space:]]*//; s/[[:space:]]*$//')
  echo "${s:0:80}"
}

if [ -n "$CUSTOM" ]; then
  BASE_NAME=$(sanitize "$CUSTOM")
else
  BASE=$(basename "$INPUT")
  BASE_NAME=$(sanitize "${BASE%.*}")
fi

echo "" >&2
echo "  Separando voces de: $INPUT" >&2
echo "  Modelo: $MODEL" >&2
echo "  Guardando en: $OUTDIR/" >&2
echo "" >&2

# --- Ensure demucs is installed (persistent via uv tool) ---
if ! command -v demucs &>/dev/null; then
  echo "  Instalando Demucs (primera vez)..." >&2
  uv tool install demucs --with numpy >&2
  echo "" >&2
fi

# --- Run Demucs (cd to SCRIPT_DIR so output lands in project root) ---
cd "$SCRIPT_DIR"
demucs --two-stems=vocals -n "$MODEL" "$INPUT" >&2

# --- Locate Demucs output (model dir mirrors -n flag) ---
INPUT_BASENAME=$(basename "$INPUT")
INPUT_BASENAME="${INPUT_BASENAME%.*}"
DEMUCS_DIR="$SCRIPT_DIR/separated/$MODEL/$INPUT_BASENAME"

if [ ! -d "$DEMUCS_DIR" ]; then
  echo "  ✗ No se encontró el directorio de salida de Demucs: $DEMUCS_DIR" >&2
  exit 1
fi

# --- Move results to OUTDIR with clear naming ---
for stem in vocals no_vocals; do
  src="$DEMUCS_DIR/$stem.wav"
  dst="$OUTDIR/${BASE_NAME}_${stem}.wav"
  if [ -f "$src" ]; then
    mv "$src" "$dst"
    echo "  ✓ $(basename "$dst")" >&2
    echo "$dst"  # stdout: machine-parseable path
  else
    echo "  ⚠  No se encontró: $src" >&2
  fi
done

# --- Clean up Demucs temp dir ---
rm -rf "$DEMUCS_DIR"

# --- Report output duration (from first stem) ---
FIRST_OUT="$OUTDIR/${BASE_NAME}_vocals.wav"
if [ -f "$FIRST_OUT" ]; then
  DUR=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$FIRST_OUT" 2>/dev/null || echo "?")
  echo "" >&2
  echo "  ✓ Listo. Duración: $(printf "%.1f" "$DUR")s" >&2
fi

echo "" >&2