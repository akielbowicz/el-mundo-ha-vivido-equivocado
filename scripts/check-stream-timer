#!/usr/bin/env bash
# check-stream-timer
# Check systemd timer status for stream recording and reset if stuck.
# Also detects if the previous service never finished (stale ffmpeg).
# Use via: just check-stream-timer

set -euo pipefail

echo "=== Timer status ==="
systemctl --user list-timers | grep --color=never download-stream || echo "No timer found"
echo ""

# Check if service has been running suspiciously long
SERVICE_START=$(systemctl --user show download-stream.service -p ActiveEnterTimestamp --value 2>/dev/null || echo "")
if [ -n "$SERVICE_START" ]; then
  NOW=$(date +%s)
  SVC_SECS=$(date -d "$SERVICE_START" +%s 2>/dev/null || echo "0")
  ELAPSED=$((NOW - SVC_SECS))
  # 5400s = 1h30m normal. If >4h something is wrong
  if [ $ELAPSED -gt 14400 ]; then
    echo "⚠ El servicio lleva $((ELAPSED / 60))min activo (inició: $SERVICE_START)"
    echo "  Posible stale ffmpeg. Ejecutando pkill + restart del servicio..."
    pkill -x ffmpeg 2>/dev/null || true
    sleep 1
    systemctl --user stop download-stream.service 2>/dev/null || true
    systemctl --user reset-failed download-stream.service 2>/dev/null || true
    systemctl --user restart download-stream.timer 2>/dev/null || true
    echo "✓ Limpiado."
    echo ""
  fi
fi

NEXT=$(systemctl --user show download-stream.timer -p NextElapseUSecRealtime --value 2>/dev/null || echo "n/a")

if [ "$NEXT" = "n/a" ] || [ -z "$NEXT" ]; then
  echo "⚠ Timer stuck (no next trigger). Resetting..."
  systemctl --user reenable download-stream.timer 2>/dev/null
  systemctl --user restart download-stream.timer 2>/dev/null
  echo "✓ Reset done, re-checking:"
  systemctl --user list-timers | grep --color=never download-stream
else
  echo "✓ Next trigger: $NEXT"
fi