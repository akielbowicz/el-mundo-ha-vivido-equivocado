#!/usr/bin/env bash
set -euo pipefail

# download-stream
# Graba un stream de radio con ffmpeg.
# Diseñado para timers systemd (local o VM Oracle): corta automáticamente,
# tolera corrupción, archivos timestamp.
#
# Uso:
#   ./scripts/download-stream                           # 1 hora por defecto
#   ./scripts/download-stream --duration 2h             # 2 horas
#   ./scripts/download-stream --duration 30m            # 30 minutos
#   ./scripts/download-stream --duration 5m30s          # 5 min 30 seg
#   ./scripts/download-stream --duration 1200           # 1200 segundos
#   ./scripts/download-stream --outdir /tmp/grabaciones # dir custom
#
# Cron (ej: jueves 18:45 → 20:15 — graba 1h30m):
#   45 18 * * 4 /ruta/al/proyecto/scripts/download-stream --duration 1h30m

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

STREAM_URL="https://radio01.ferozo.com/proxy/ra01001031?mp=/stream"
OUTDIR="${SCRIPT_DIR}/materiales/grabaciones"
DURATION=3600

# Notificación opcional de fallos (ntfy.sh): NTFY_URL=https://ntfy.sh/<topic>
notify() {
  if [ -n "${NTFY_URL:-}" ]; then
    curl -s --max-time 10 -d "$1" "$NTFY_URL" >/dev/null 2>&1 || true
  fi
}

usage() {
  cat >&2 <<EOF
Uso: $(basename "$0") [--duration N] [--outdir DIR]

Descarga un stream de radio con ffmpeg.

Opciones:
  --duration N    Duración (ej: 1h, 30m, 5m30s, 3600, 5:30; defecto: 1h)
  --outdir DIR    Directorio de salida (defecto: \$PROJECT/materiales/grabaciones)
  --help, -h      Esta ayuda
EOF
}

usage_ok() {
  usage
  exit 0
}

usage_err() {
  usage
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --duration) DURATION="$2"; shift 2 ;;
    --outdir)   OUTDIR="$2";   shift 2 ;;
    --help|-h)  usage_ok ;;
    *)          echo "  ✗ Argumento desconocido: $1" >&2; usage_err ;;
  esac
done

# Validar formato de duración (ffmpeg-compatible)
# Acepta: 3600, 10s, 5m, 2h, 5m30s, 1h30m, 1h30m15s, 5:30, 1:30:00

# Convertir duración a segundos para ffmpeg -t
duration_to_seconds() {
  local d="$1"
  case "$d" in
    *:*:*)
      # HH:MM:SS
      local h m s
      IFS=: read -r h m s <<< "$d"
      echo $((10#$h * 3600 + 10#$m * 60 + 10#$s))
      ;;
    *:*)
      # MM:SS
      local m s
      IFS=: read -r m s <<< "$d"
      echo $((10#$m * 60 + 10#$s))
      ;;
    *h*m*s)
      local h m s
      d="${d%h*} ${d#*h}"; d="${d%m*} ${d#*m}"; d="${d%s}"
      read -r h m s <<< "$d"
      echo $((10#$h * 3600 + 10#$m * 60 + 10#$s))
      ;;
    *h*m)
      local h m
      d="${d%h*} ${d#*h}"; d="${d%m}"
      read -r h m <<< "$d"
      echo $((10#$h * 3600 + 10#$m * 60))
      ;;
    *h*s)
      local h s
      d="${d%h*} ${d#*h}"; d="${d%s}"
      read -r h s <<< "$d"
      echo $((10#$h * 3600 + 10#$s))
      ;;
    *m*s)
      local m s
      d="${d%m*} ${d#*m}"; d="${d%s}"
      read -r m s <<< "$d"
      echo $((10#$m * 60 + 10#$s))
      ;;
    *h) echo $((10#${d%h} * 3600)) ;;
    *m) echo $((10#${d%m} * 60)) ;;
    *s) echo $((10#${d%s})) ;;
    *)  echo "$d" ;;
  esac
}

# Validar formato
if ! [[ "$DURATION" =~ ^[0-9]+$ ]] && \
   ! [[ "$DURATION" =~ ^[0-9]+[smh]([0-9]+[smh])?$ ]] && \
   ! [[ "$DURATION" =~ ^[0-9]+:[0-9]{2}(:[0-9]{2})?$ ]]; then
  echo "  ✗ Duración inválida: '$DURATION'. Usá formato como 1h, 30m, 5m30s, 3600, 5:30" >&2
  exit 1
fi

# Convertir a segundos para ffmpeg
DURATION_SECS=$(duration_to_seconds "$DURATION")

# Verificar que ffmpeg está instalado
if ! command -v ffmpeg &>/dev/null; then
  echo "  ✗ ffmpeg no está instalado. Instalá ffmpeg primero." >&2
  exit 1
fi

# Matar cualquier ffmpeg anterior DEL STREAM (evita que una instancia stale
# bloquee la próxima grabación: systemd no arranca un nuevo service si el
# anterior sigue "activating"). Con -f scopeado a la URL del stream para NO
# matar otros ffmpeg del sistema (encodings, transcodes, etc.)
pkill -f "radio01.ferozo.com" 2>/dev/null || true
sleep 1

mkdir -p "$OUTDIR"

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="${OUTDIR}/stream_${TIMESTAMP}_${DURATION_SECS}s.mp3"

echo "" >&2
echo "  Stream:   $STREAM_URL" >&2
echo "  Duración: ${DURATION} → ${DURATION_SECS}s" >&2
echo "  Archivo:  $OUTFILE" >&2
echo "" >&2

# Timeout = duración + 15 min de margen — evita que ffmpeg cuelgue indefinidamente
# si el stream se corta sin cerrar la conexión (causa del stale de 7 días)
# -reconnect: recupera la grabación si el stream se desconecta momentáneamente
FFMPEG_TIMEOUT=$((DURATION_SECS + 900))
set +e
timeout "$FFMPEG_TIMEOUT" ffmpeg -y \
  -reconnect 1 \
  -reconnect_streamed 1 \
  -reconnect_delay_max 10 \
  -i "$STREAM_URL" \
  -t "$DURATION_SECS" \
  -c copy \
  -fflags +discardcorrupt \
  "$OUTFILE" 2>&1
FFMPEG_EXIT=$?
set -e

if [ "$FFMPEG_EXIT" -eq 124 ]; then
  # Timeout no es error de grabación: conservar el parcial (puede tener horas
  # de audio válido). Borrarlo acá sería tirar la grabación entera.
  echo "  ⚠ Timeout (${FFMPEG_TIMEOUT}s) — conservando grabación parcial: $OUTFILE" >&2
  notify "download-stream: timeout — parcial conservado ($OUTFILE)"
elif [ "$FFMPEG_EXIT" -ne 0 ] || [ ! -s "$OUTFILE" ]; then
  echo "  ✗ Error grabando stream (exit $FFMPEG_EXIT). Eliminando archivo parcial." >&2
  rm -f "$OUTFILE"
  notify "download-stream: error grabando (exit $FFMPEG_EXIT)"
  exit 1
fi

# Validación de duración — avisa si quedó corta (stream caído, reconnects, etc.)
DURATION=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$OUTFILE" 2>/dev/null | cut -d. -f1)
DURATION=${DURATION:-0}
if [ "$DURATION" -lt $((DURATION_SECS * 90 / 100)) ]; then
  echo "  ⚠ Grabación corta: ${DURATION}s de ${DURATION_SECS}s esperados — revisar antes de publicar" >&2
  notify "download-stream: grabación corta (${DURATION}s de ${DURATION_SECS}s)"
fi

# Retención: mantener solo las últimas 12 grabaciones (el disco no es infinito)
# (sort alfabético = cronológico: el nombre lleva timestamp)
find "${OUTDIR}" -maxdepth 1 -name 'stream_*.mp3' -type f | sort -r | tail -n +13 | xargs -r rm -f

echo "" >&2
echo "  ✓ Grabado: $OUTFILE ($(du -h "$OUTFILE" | cut -f1))" >&2
echo "" >&2